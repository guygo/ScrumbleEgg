# Copy this to .env and fill in values. Never commit .env.

# SQLAlchemy DB URL — defaults to ~/.scrumbleeggs/scrumbleeggs.db
# SBE_DB_URL=sqlite:////path/to/your/scrumbleeggs.db
# SBE_DB_URL=postgresql://user:pass@localhost:5432/scrumbleeggs

# Logging level: DEBUG, INFO, WARNING, ERROR
SBE_LOG_LEVEL=WARNING

# Default assignee pre-filled in all ticket wizards
SBE_DEFAULT_ASSIGNEE=

# Default page size for list command
SBE_PAGE_SIZE=20

# Ticket key prefix (e.g. SBE -> SBE-1, SBE-2, ...)
SBE_PROJECT_PREFIX=SBE
